{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WoW Addons",
  "version": "0.1.0",
  "identifier": "io.wowaddons.desktop",
  "mainBinaryName": "wow-addons",
  "build": {
    "frontendDist": "desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WoW Addons",
        "width": 1180,
        "height": 790,
        "minWidth": 760,
        "minHeight": 520,
        "backgroundColor": "#15171c",
        "dragDropEnabled": true,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["build/icon.png", "build/icon.ico", "build/icon.icns"],
    "shortDescription": "Compact World of Warcraft addon manager",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": ["English"]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGMjgyRkQyQTMxRDhBOTUKUldTVmloMmowaThvTHdqYjJJTXBQcURJT2tXYXJsN1hOZWVrOHV6K1dqcS9LVnFSM1d1YXFnS0YK",
      "endpoints": ["https://github.com/h2u/wow-addons/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
